{
  "name": "node-runner",
  "version": "1.0.0",
  "description": "Jest test runner for pfa-test-automation pipeline",
  "private": true,
  "scripts": {
    "test": "jest",
    "coverage": "jest --coverage",
    "coverage:nyc": "nyc --reporter=text --reporter=json-summary jest"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nyc": "^18.0.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/generated-tests/**/*.test.js",
      "**/examples/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "projet-reference/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "json-summary",
      "lcov",
      "html"
    ],
    "testTimeout": 30000
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "express": "^5.2.1"
  }
}
