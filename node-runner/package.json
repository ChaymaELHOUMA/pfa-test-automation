{
  "name": "node-runner",
  "version": "1.0.0",
  "description": "Jest test runner for pfa-test-automation pipeline",
  "private": true,
  "scripts": {
    "test": "jest"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/generated-tests/**/*.test.js",
      "**/examples/**/*.test.js"
    ],
    "testTimeout": 30000
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "express": "^5.2.1"
  }
}
